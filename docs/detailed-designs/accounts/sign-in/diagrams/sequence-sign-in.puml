@startuml
title UML sequence behaviour — Sign in
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "SignInPage" as page
  participant "ReturnUrlPolicy" as ret
  participant "AuthApi" as client
end box
box "Backend — Logos Lab API" #D1FADF
  participant "sessions route handler" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "SignInAction" as action
  participant "CredentialVerifier" as cred
  participant "AccountStatePolicy" as state
  participant "SessionService" as sessions
  participant "MfaChallengeService" as mfa
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
  participant "Amazon CloudWatch" as cw
end box
actor -> page : Submit email and password
page -> client : signIn(SignInRequest)
client -> route : POST /api/v1/auth/sessions
route -> action : execute(input, ctx)
note over action : Throttle checks run first (see brute-force sequence)
action -> cred : verify(email, password)
cred -> db : Find user by normalized email
db --> cred : User or none
cred -> cred : Verify hash (dummy hash when user unknown)
alt wrong password or unknown email
  cred --> action : null
  action -> cw : Log sign-in failure (no password)
  action --> route : InvalidCredentials
  route --> client : 401 "invalid-credentials"
  client --> page : Failed
  page --> actor : "Email or password is incorrect" (same for both, L2-008)
else credentials correct
  cred --> action : User
  action -> state : assertCanSignIn(user)
  alt Suspended or Deactivated
    state --> action : Refused with state and end date
    action --> route : AccountRefused
    route --> client : 403 "account-suspended" or "account-deactivated"
    page --> actor : Explain status and how to contact support
  else two-step verification on
    action -> mfa : start(user)
    mfa -> db : Store pending challenge
    action --> route : SecondFactorRequired
    route --> client : 200, challenge cookie, no session yet (L2-008, L2-014)
    page --> actor : Navigate to /sign-in/verify
  else Active or Unverified, no second factor
    action -> sessions : create(user, ctx)
    sessions -> db : Insert session (token hash, device, IP)
    sessions --> action : IssuedSession
    action -> cw : Log sign-in success
    action --> route : SignedIn
    route --> client : 200, Set-Cookie session
    client --> page : SignedIn
    page -> ret : resolve(returnUrl)
    ret --> page : Same-origin path or /dashboard (L2-008)
    page --> actor : Navigate to resolved page
  end
end
@enduml
