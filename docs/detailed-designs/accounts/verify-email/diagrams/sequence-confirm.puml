@startuml
title UML sequence behaviour — Confirm the email address
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "VerifyEmailPage" as page
  participant "AuthApi" as client
end box
box "Backend — Logos Lab API" #D1FADF
  participant "email-verifications route handler" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "VerifyEmailAction" as action
  participant "AccountTokenService" as tokens
  participant "User" as user
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
end box
actor -> page : Open /verify-email?token=...
page --> actor : Show "Confirm my email" (link not yet used)
actor -> page : Press "Confirm my email"
page -> client : confirmEmail(token)
client -> route : POST /api/v1/auth/email-verifications
route -> action : execute(token)
action -> tokens : consume(token, EmailVerification)
tokens -> db : Find unused token by hash with expiresAt > now
db --> tokens : Token or none
alt token valid (L2-007: within 24 hours, unused)
  tokens -> db : Set usedAt (single use)
  tokens --> action : AccountToken
  action -> user : activate()
  user --> action : State Unverified -> Active
  action -> db : Save user in the same transaction
  db --> action : Committed
  action --> route : Ok
  route --> client : 204
  client --> page : Verified
  page --> actor : Show success state
else expired, used or unknown token
  tokens --> action : none
  action --> route : LinkExpired
  route --> client : 410 problem "link-expired"
  client --> page : Expired
  page --> actor : Show expired state with "Send a new link"
end
@enduml
