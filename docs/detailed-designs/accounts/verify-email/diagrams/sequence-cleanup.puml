@startuml
title UML sequence behaviour — Unverified account cleanup
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "UnverifiedAccountCleanupJob" as job
  participant "UserRepository" as repo
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  participant "Nightly schedule (<TO SUPPLY>)" as sched
  queue "Job queue" as queue
  database "Logos Lab database" as db
end box
sched -> queue : Enqueue UnverifiedAccountCleanupJob (nightly)
queue -> job : Deliver message to Worker
job -> job : Compute cutoff = now - 30 days (L2-007)
job -> repo : deleteUnverifiedBefore(cutoff)
repo -> db : Delete users in state Unverified created before cutoff, with their personal data and tokens
db --> repo : Rows deleted
repo --> job : Count
job --> queue : Acknowledge (idempotent; a re-run deletes nothing new)
@enduml
