@startuml
title UML sequence behaviour — Change password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "SettingsAccountPage" as page
  participant "AccountApi" as client
end box
box "Backend — Logos Lab API" #D1FADF
  participant "me/password route handler" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "ChangePasswordAction" as action
  participant "PasswordHasher" as hasher
  participant "PasswordPolicyService" as pwd
  participant "SessionService" as sessions
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
end box
actor -> page : Enter current and new password, press "Change password"
page -> client : changePassword(current, next)
client -> route : PUT /api/v1/me/password
route -> action : execute(currentUser, current, next)
action -> db : Load user by caller id
action -> hasher : verify(passwordHash, current)
alt current password wrong
  action --> route : IdentityProblem
  route --> client : 422 problem on currentPassword
  page --> actor : Invalid state
else confirmed
  action -> pwd : validate(next)
  action -> action : Apply L2-012 rule: next differs from current
  alt rules fail
    action --> route : PasswordProblem
    route --> client : 422 problem on newPassword
    page --> actor : Invalid state, error under the field
  else valid
    action -> hasher : hash(next)
    action -> db : Save hash and passwordChangedAt
    action -> sessions : revokeAllExcept(userId, currentSession)
    sessions -> db : Revoke every other session (L2-010)
    action --> route : Ok
    route --> client : 204
    page --> actor : Success state, other sessions signed out
  end
end
@enduml
