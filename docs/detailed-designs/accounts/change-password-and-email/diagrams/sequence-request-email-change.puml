@startuml
title UML sequence behaviour — Request an email change
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "SettingsAccountPage" as page
  participant "AccountApi" as client
end box
box "Backend — Logos Lab API" #D1FADF
  participant "me/email-change route handler" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "RequestEmailChangeAction" as action
  participant "PasswordHasher" as hasher
  participant "AccountTokenService" as tokens
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
  queue "Job queue" as queue
end box
actor -> page : Enter new address and current password
page -> client : requestEmailChange(newEmail, currentPassword)
client -> route : POST /api/v1/me/email-change
route -> action : execute(currentUser, newEmail, currentPassword)
action -> hasher : verify(passwordHash, currentPassword)
alt current password wrong
  route --> client : 422 problem on currentPassword
  page --> actor : Invalid state
else confirmed
  action -> db : Is newEmail used by another account?
  db --> action : Answer
  alt address free
    action -> db : Set pendingEmail on the user, email unchanged
    action -> tokens : issue(userId, EmailChange, 24 h)
    tokens -> db : Store token hash
    action -> queue : Enqueue EmailSendJob (link to the new address)
  else address belongs to another account
    action -> action : Change nothing (L2-012)
  end
  action --> route : Accepted
  route --> client : 202, same response in both cases
  page --> actor : Pending-email state: link sent, email unchanged until opened
end
@enduml
