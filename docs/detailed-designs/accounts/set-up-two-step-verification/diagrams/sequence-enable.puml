@startuml
title UML sequence behaviour — Turn on two-step verification
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "MfaSetupPage" as page
  participant "AccountApi" as client
end box
box "Backend — Logos Lab API" #D1FADF
  participant "me/mfa route handlers" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "StartMfaEnrolmentAction" as start
  participant "ConfirmMfaEnrolmentAction" as confirm
  participant "TotpService" as totp
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  participant "AWS KMS" as kms
  database "Logos Lab database" as db
  queue "Job queue" as queue
end box
actor -> page : Open /settings/security/two-step
page -> client : startMfaEnrolment()
client -> route : POST /api/v1/me/mfa/enrolment
route -> start : execute(currentUser)
start -> totp : generateSecret()
start -> kms : Encrypt secret
start -> db : Upsert MfaEnrolment (Pending)
start --> route : otpauth URI and key
route --> client : 200 MfaEnrolmentStart
page --> actor : QR code and key
actor -> page : Scan with authenticator app, enter 6-digit code
page -> client : confirmMfaEnrolment(code)
client -> route : POST /api/v1/me/mfa/enrolment/confirmation
route -> confirm : execute(currentUser, code)
confirm -> kms : Decrypt secret
confirm -> totp : verify(secret, code)
alt code does not match
  route --> client : 422 problem on code
  page --> actor : Invalid state
else valid (L2-014)
  confirm -> db : Set Enabled, enabledAt; insert 10 recovery code hashes
  confirm -> queue : Enqueue EmailSendJob (two-step turned on)
  confirm --> route : 10 plain recovery codes
  route --> client : 200 MfaEnabled (codes shown once, never retrievable again)
  page --> actor : Success state with recovery codes, download and copy
end
@enduml
