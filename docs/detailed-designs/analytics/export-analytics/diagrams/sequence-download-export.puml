@startuml
title UML sequence behaviour — Download a background export
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Expert, Editor or Administrator" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "Browser" as page
end box
box "Backend — Logos Lab API" #D1FADF
  participant "GET /api/v1/analytics/exports/{id}/download" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "DownloadAnalyticsExportAction" as action
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
  database "Amazon S3 exports" as s3
end box
actor -> page : Open the link from the email or notification
page -> route : HTTPS GET with session
route -> route : Authenticate
route -> action : execute(currentUserId, id, now)
action -> db : Load export where id and requester = current user
alt not found or another user's export
  action --> route : 404 (L2-017)
  route --> page : Not-found page
else expired (now after expiresAt)
  action --> route : 410 Gone
  route --> page : Link expired; export again (L2-103)
else ready
  action -> s3 : Create signed GET URL valid for minutes (TO SUPPLY)
  s3 --> action : Signed URL
  action --> route : SignedUrl
  route --> page : 302 to signed URL
  page -> s3 : GET file
  s3 --> page : CSV
  page --> actor : File downloaded
end
@enduml
