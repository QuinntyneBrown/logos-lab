@startuml
title UML sequence behaviour — Switch to the test locale
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Developer" as actor
box "Delivery — CI pipeline" #F2F4F7
  participant "CI pipeline" as ci
  participant "LocaleFormattingSuite" as suite
  participant "<Name>PageObject" as po
end box
box "Frontend — Logos Lab Web" #E0F2FE
  participant "Logos Lab Web (fr-CA build)" as web
  participant "LocaleFormatService" as svc
end box
actor -> ci : Push change
ci -> ci : Build fr-CA from the same source; no code change (L2-148 AC3)
ci -> web : Serve fr-CA with seed data
ci -> suite : Run
loop Event, course and dashboard pages
  suite -> po : Read displayed dates, times and numbers
  po -> web : Open page
  web -> svc : Format with LOCALE_ID = fr-CA
  svc --> web : "11 octobre 2026", 24-hour time, "1 284"
  web --> po : Rendered values
  po --> suite : Values
  alt Any value still in en-CA form
    suite --> ci : Fail naming the page and value
  else All values in fr-CA form
    suite --> ci : Pass
  end
end
ci --> actor : Result
@enduml
