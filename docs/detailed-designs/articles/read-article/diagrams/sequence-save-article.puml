@startuml
title UML sequence behaviour — Save an article for later
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Learner" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "ArticlePage" as ArticlePage
  participant "SavedItemsApi" as SavedItemsApi
end box
box "Backend — Logos Lab API" #D1FADF
  participant "PUT /api/v1/me/saved/contentId" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "SaveItemAction" as SaveItemAction
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
end box
actor -> ArticlePage : Press Save
alt visitor (not signed in)
  ArticlePage --> actor : Ask to sign in first
else signed-in member
  ArticlePage -> SavedItemsApi : save(articleId)
  SavedItemsApi -> route : HTTPS PUT with session
  route -> route : Authenticate
  route -> SaveItemAction : execute(userId, articleId)
  SaveItemAction -> db : Insert saved item for current user if absent (L2-071, L2-017)
  db --> SaveItemAction : Commit
  SaveItemAction --> route : Saved
  route --> SavedItemsApi : 200 JSON
  SavedItemsApi --> ArticlePage : Saved
  ArticlePage --> actor : Button reads Saved with aria-pressed true; toast with Undo (L2-045)
end
@enduml
