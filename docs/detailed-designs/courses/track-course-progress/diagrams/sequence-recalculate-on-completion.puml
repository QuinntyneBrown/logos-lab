@startuml
title UML sequence behaviour — Recalculate progress on a lesson completion
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Learner" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "LessonPlayerPage" as page
  participant "CourseOverviewPage / DashboardPage" as other
end box
box "Backend — Logos Lab API" #D1FADF
  participant "Route handler" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "LessonCompletionService" as comp
  participant "ProgressService" as prog
  participant "ProgressCalculator" as calc
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
end box
actor -> page : Complete a lesson
page -> route : POST completion
route -> comp : Record completion
comp -> db : Begin transaction; insert lesson_completion
comp -> prog : recalculate(enrolmentId)
prog -> db : Load required lesson ids and completed ids
db --> prog : Ids
prog -> calc : Apply L2-030 required-only formula
calc --> prog : Whole percentage
prog -> db : Update enrolments.progress_percent; commit
db --> prog : Commit
prog --> comp : Percentage
comp --> route : CompletionResult
route --> page : 200 with progressPercent
page --> actor : Progress bar shows new value with accessible name
actor -> other : Open overview or dashboard
other -> route : GET learner state (no-store)
route -> db : Read enrolments.progress_percent
db --> route : Same percentage
route --> other : 200 state
other --> actor : Same percentage within 5 seconds (L2-030)
@enduml
