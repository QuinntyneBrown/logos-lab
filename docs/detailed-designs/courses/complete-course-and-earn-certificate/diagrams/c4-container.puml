@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Complete a course and earn a certificate

Person(learner, "Learner", "Signed-in member who studies courses and modules")
System_Boundary(logos, "Logos Lab") {
  Container(web, "Logos Lab Web", "Angular, Angular SSR on Node.js", "Single web application for every role")
  Container(api, "Logos Lab API", "Next.js route handlers, TypeScript", "JSON API under /api/v1 with domain services and actions")
  ContainerDb(db, "Logos Lab database", "PostgreSQL on Amazon RDS", "System of record")
  ContainerDb(s3, "Media storage", "Amazon S3", "Private buckets for SCORM packages and generated files")
}
System_Ext(linkedin, "LinkedIn", "Professional network; receives certificates through its Add to profile link")

Rel(learner, web, "Completes lessons, opens certificate", "HTTPS")
Rel(web, api, "Completion, certificate, PDF and reissue calls", "JSON/HTTPS")
Rel(api, db, "Writes enrolment completion and certificates", "SQL")
Rel(api, s3, "Caches and serves certificate PDFs", "AWS SDK, signed URL")
Rel(web, linkedin, "Opens Add to profile link", "HTTPS")
@enduml
