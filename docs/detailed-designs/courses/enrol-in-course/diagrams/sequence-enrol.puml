@startuml
title UML sequence behaviour — Enrol in a course
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "CourseOverviewPage" as page
  participant "HttpCoursesApi" as client
end box
box "Backend — Logos Lab API" #D1FADF
  participant "courses/[slug]/enrolment route" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "EnrolInCourseAction" as action
  participant "EnrolmentService" as svc
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
end box
actor -> page : Press Enrol
page -> page : Show Enrolling...
page -> client : enrol(slug)
client -> route : POST /api/v1/courses/{slug}/enrolment
route -> route : Authenticate session and CSRF check
route -> action : execute(slug, user)
action -> db : Load published course and user's enrolment (L2-017)
db --> action : Course, enrolment or none
action -> svc : Apply L2-027 enrolment rules
alt email not verified
  svc --> action : Refused, email-unverified
  action --> route : Refused
  route --> client : 403 problem email-unverified
  client --> page : Unverified
  page --> actor : Open VerifyEmailPromptDialog (L2-007), no enrolment
else already Active or Completed
  svc --> action : Existing enrolment
  action --> route : Existing
  route --> client : 200 existing enrolment (no duplicate)
  client --> page : Enrolment
  page --> actor : Navigate to first incomplete lesson
else Left within 12 months
  svc --> action : Restore enrolment and keep completions
  action -> db : Update status to Active
  db --> action : Commit
  action --> route : Restored
  route --> client : 200 restored enrolment
  client --> page : Enrolment
  page --> actor : Navigate to first incomplete lesson
else no enrolment, or left over 12 months
  svc --> action : New enrolment at 0%
  action -> db : Insert enrolment, unique on user and course
  db --> action : Commit
  action --> route : Created
  route --> client : 201 enrolment
  client --> page : Enrolment
  page --> actor : Navigate to first lesson; course appears on dashboard
end
@enduml
