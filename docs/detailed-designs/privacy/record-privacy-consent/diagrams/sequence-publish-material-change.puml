@startuml
title UML sequence behaviour — Publish a material policy change
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Administrator" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "PolicyEditorPage" as page
  participant "PoliciesApi" as client
end box
box "Backend — Logos Lab API" #D1FADF
  participant "admin policy route handler" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "PublishPolicyVersionAction" as action
  participant "PolicyService" as pol
  participant "AuditLogService" as audit
  participant "PolicyChangeNoticeJob" as job
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
  queue "Job queue (SQS)" as queue
  participant "Amazon SES" as ses
end box
actor -> page : Edit text, set effective date, tick "Material change"
page -> client : createVersion(type, body, effectiveAt, materialChange, summary)
client -> route : POST /api/v1/admin/policies/{type}/versions
route -> route : Authenticate; require Administrator role
route -> action : Execute
action -> pol : Validate version
alt Material change effective sooner than 30 days ahead
  pol --> action : Invalid effective date
  action --> route : Field error
  route --> client : 400 with field-level errors
  client --> page : Show invalid state
else Valid
  pol -> db : Insert policy_versions row, next version number (L2-098)
  action -> audit : Record policy change with before and after (L2-099)
  audit -> db : Append audit entry
  action -> queue : Enqueue PolicyChangeNoticeJob
  action --> route : Version created
  route --> client : 201
  client --> page : Show success state
  queue -> job : Deliver job
  loop Each member with an email address
    job -> ses : Send notice 30 days before effective date (L2-119)
  end
end
@enduml
