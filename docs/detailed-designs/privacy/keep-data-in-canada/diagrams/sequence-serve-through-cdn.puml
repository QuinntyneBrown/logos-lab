@startuml
title UML sequence behaviour — Serve a request through the CDN
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor or member" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "Browser" as browser
  participant "SsrCachePolicy (SSR server)" as ssr
end box
box "Backend — Logos Lab API" #D1FADF
  participant "Route handler" as route
  participant "CacheControlPolicy" as ccp
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "SignedMediaUrlService" as sms
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  participant "CDN (CloudFront)" as cdn
  database "Media storage (S3, Canada)" as s3
end box
actor -> browser : Open a page or start an action
alt Anonymous page request (no session cookie)
  browser -> cdn : GET page
  cdn -> ssr : Forward on cache miss
  ssr -> ssr : No session cookie, allow public caching
  ssr --> cdn : HTML with public Cache-Control
  cdn --> browser : Page (cached for later visitors)
else Request with a session cookie or to /api/v1
  browser -> cdn : GET page or API call with cookie
  cdn -> route : Forward under CachingDisabled behaviour
  route -> ccp : Map result to response
  ccp -> ccp : Apply L2-113 rule: authenticated response is private, no-store
  ccp --> cdn : Response with Cache-Control: private, no-store
  cdn --> browser : Response, nothing stored at the edge
else Media request
  route -> sms : Sign object key for the viewer
  sms --> route : Short-lived signed URL
  route --> browser : Signed URL in JSON
  browser -> cdn : GET media with signature
  cdn -> cdn : Verify signature and expiry
  cdn -> s3 : Fetch object on cache miss
  s3 --> cdn : Object
  cdn --> browser : Media
end
@enduml
