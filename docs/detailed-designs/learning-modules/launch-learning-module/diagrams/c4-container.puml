@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Launch a learning module

Person(learner, "Learner", "Signed-in member who studies courses and modules")
System_Boundary(logos, "Logos Lab") {
  Container(web, "Logos Lab Web", "Angular, Angular SSR on Node.js", "Single web application for every role")
  Container(api, "Logos Lab API", "Next.js route handlers, TypeScript", "JSON API under /api/v1 with domain services and actions")
  ContainerDb(db, "Logos Lab database", "PostgreSQL on Amazon RDS", "System of record")
  Container(origin, "SCORM content origin", "Amazon CloudFront on a separate registrable domain", "Serves unpacked SCORM content")
  ContainerDb(s3, "Media storage", "Amazon S3", "Private buckets for SCORM packages and generated files")
}
System_Ext(tesss, "Tessera scorm-player", "SCORM player library embedded in Logos Lab Web; sandboxed iframe and message bridge")
System_Ext(secrets, "AWS Secrets Manager", "Holds the launch-URL signing key")
System_Ext(cw, "Amazon CloudWatch", "Logs, metrics and alarms, including security events")

Rel(learner, web, "Presses Start or Resume", "HTTPS")
Rel(web, tesss, "Embeds")
Rel(web, api, "POST launches, POST launch-failures", "JSON/HTTPS")
Rel(api, db, "Reads module and package, writes attempts", "SQL")
Rel(api, secrets, "Reads signing key", "AWS SDK")
Rel(api, cw, "Logs launch failures", "AWS SDK")
Rel(tesss, origin, "Loads content in sandboxed iframe with signed URL", "HTTPS")
Rel(origin, s3, "Reads unpacked package files", "HTTPS")
@enduml
