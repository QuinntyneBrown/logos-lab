@startuml
title UML sequence behaviour — Serve SCORM content on the content origin
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Learner's browser" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "SCORM content (iframe)" as content
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  entity "Launch token edge function (CloudFront)" as edge
  database "Media storage (S3)" as s3
end box
actor -> content : Load package page or asset
content -> edge : GET /l/{token}/packages/{packageId}/{path}
edge -> edge : Verify HMAC, package id in token, expiry (4 hours, L2-034)
alt token invalid or expired
  edge --> content : 403 Forbidden
  content --> actor : Asset not loaded; player times out or retries launch
else valid
  edge -> s3 : Fetch packages/{packageId}/{path}
  s3 --> edge : File
  edge --> content : 200 with CSP frame-ancestors www.logoslab.ca
  content --> actor : Content renders, isolated from application cookies
end
@enduml
