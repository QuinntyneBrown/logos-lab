@startuml
title UML sequence behaviour — Refresh the unread count
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "Header bell" as bell
  participant "UnreadNotificationsStore" as store
  participant "NotificationsApi" as client
end box
box "Backend — Logos Lab API" #D1FADF
  participant "GET /api/v1/notifications/unread-count" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "GetUnreadNotificationCountAction" as action
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
end box
actor -> bell : Load any page while signed in
bell -> store : start()
loop every poll interval (under 30 s, value TO SUPPLY) while the page is open
  store -> client : unreadCount()
  client -> route : HTTPS GET
  route -> route : Authenticate session
  route -> action : execute(currentUserId)
  action -> db : Count rows where recipient_id = user and read_at is null
  db --> action : Count
  action --> route : Count
  route --> client : 200 JSON, Cache-Control no-store
  client --> store : Count
  store -> store : Badge text is the count, or "9+" above 9
  store --> bell : Update count and label "Notifications, N unread" (L2-091)
  bell --> actor : Count changes without a page reload
end
@enduml
