@startuml
title UML sequence behaviour — Skip to content
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Keyboard user" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "AppShell" as shell
  participant "ll-skip-link" as skip
  participant "main#main" as main
end box
actor -> shell : Load page; press Tab
shell -> skip : First focusable element receives focus (L2-126 AC1)
skip --> actor : Link becomes visible with 2px focus ring, offset 3px (L2-126 AC2)
alt Activate skip link
  actor -> skip : Enter
  skip -> main : Move focus to main content
  main --> actor : Next Tab reaches the first control in main
else Press Tab again
  actor -> shell : Tab
  shell --> actor : Focus moves through header in visual order
end
@enduml
