@startuml
title UML sequence behaviour — Announce an asynchronous result
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Learner using a screen reader" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "ArticlePage" as page
  participant "HttpLibraryApi" as client
  participant "Announcer" as ann
  participant "ll-toast region" as toast
end box
box "Backend — Logos Lab API" #D1FADF
  participant "Save route handler" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "Save action" as act
end box
actor -> page : Activate Save (aria-pressed=false)
page -> client : save(contentId)
client -> route : POST
route -> act : execute(contentId, currentUserId)
act --> route : Saved
route --> client : 200
client --> page : Saved
page -> page : Set aria-pressed=true on Save (L2-127 AC2)
page -> toast : Show "Saved" in role=status region
page -> ann : polite("Saved to your library") (L2-127 AC3)
ann --> actor : Announced; focus stays on Save
@enduml
