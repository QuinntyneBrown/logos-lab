@startuml
title UML sequence behaviour — Schedule
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Editor" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "PublishScheduleDialog" as dialog
  participant "HttpStudioApi" as client
end box
box "Backend — Logos Lab API" #D1FADF
  participant "items/{id}/schedule route" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "ScheduleContentAction" as action
  participant "WorkflowService" as workflow
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
end box
actor -> dialog : Choose Schedule, date and time in own time zone
dialog -> client : schedule(id, date, time, timeZone, rowVersion)
client -> route : POST /api/v1/studio/items/{id}/schedule
route -> route : Authenticate, require Editor role, validate schema
route -> action : execute(editor, id, localSchedule, rowVersion)
action -> action : Convert local date and time to a UTC instant
alt Instant is not in the future
  action --> route : Field error on time
  route --> client : 400 problem response with field errors
  client --> dialog : Invalid state naming the current time
else Future instant
  action -> db : Load item FOR UPDATE
  db --> action : Item
  action -> workflow : transition(item, Scheduled, editor)
  alt Not Approved, or stale rowVersion
    workflow --> action : Refused with current state
    action --> route : Conflict
    route --> client : 409 problem response with current state
    client --> dialog : Failed state; choices kept
  else Allowed
    workflow --> action : Allowed
    action -> db : Set state Scheduled and scheduled_for; append WorkflowTransition
    db --> action : Commit
    action --> route : Item Scheduled
    route --> client : 200 JSON
    client --> dialog : Success
    dialog --> actor : Scheduled, shown in the editor's time zone (L2-079)
  end
end
@enduml
