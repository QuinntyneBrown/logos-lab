@startuml
title UML sequence behaviour — Open a preview
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Author, Editor or anyone else" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "PreviewPage (SSR)" as page
  participant "HttpStudioApi" as client
end box
box "Backend — Logos Lab API" #D1FADF
  participant "items/{id}/preview route" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "GetPreviewAction" as action
  participant "ContentAccessPolicy" as policy
  participant "PublicContentMapper" as mapper
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
end box
actor -> page : Open /studio/preview/{id}
page -> client : getPreview(id) with session cookie
client -> route : GET /api/v1/studio/items/{id}/preview
route -> route : Resolve session
route -> action : execute(currentUser, id)
action -> db : Load item and working revision
db --> action : Item or nothing
action -> policy : canPreview(currentUser, item)
alt No item, or caller is not the author, an attributed expert or an editor
  policy --> action : false
  action --> route : Not found
  route --> client : 404 problem response (L2-078)
  client --> page : Not found
  page --> actor : 404 page with noindex and Cache-Control private, no-store
else Author or editor
  policy --> action : true
  action -> mapper : fromRevision(item, revision)
  mapper --> action : PublicContentView
  action --> route : View
  route --> client : 200 JSON, Cache-Control private, no-store
  client --> page : View
  page -> page : Render public layout at XL in the current theme
  page -> page : Add noindex meta and X-Robots-Tag noindex (L2-078)
  page --> actor : Public layout under persistent Preview - not published banner
end
@enduml
