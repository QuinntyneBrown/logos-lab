@startuml
title UML sequence behaviour — Request changes
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Editor" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "ReviewItemPage" as page
  participant "RequestChangesDialog" as dialog
  participant "HttpStudioApi" as client
end box
box "Backend — Logos Lab API" #D1FADF
  participant "studio/items/{id} routes" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "AddReviewCommentAction" as addc
  participant "RequestChangesAction" as action
  participant "WorkflowService" as workflow
  participant "NotificationService" as notify
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
  queue "Job queue" as sqs
end box
loop For each comment
  actor -> page : Select a field or passage and write a comment
  page -> client : addReviewComment(id, anchor, body)
  client -> route : POST /api/v1/studio/items/{id}/review-comments
  route -> addc : execute(editor, id, anchor, body)
  addc -> db : Insert ReviewComment with anchor (L2-077)
  db --> addc : Saved
  addc --> route : Comment
  route --> client : 201 Created
  client --> page : Show ll-annotation beside the passage
end
actor -> page : Choose Request changes
page -> dialog : Open with anchored comments
actor -> dialog : Write note to the owner
alt Note empty
  dialog --> actor : Error links to the note field
else Note present
  dialog -> client : requestChanges(id, note, rowVersion)
  client -> route : POST /api/v1/studio/items/{id}/request-changes
  route -> action : execute(editor, id, note, rowVersion)
  action -> workflow : transition(revision, ChangesRequested, editor) (L2-076)
  alt Not In review or stale
    workflow --> action : Refused, current state
    action --> route : Conflict
    route --> client : 409 problem response with current state
    client --> dialog : Show failed state; note and comments kept
  else Allowed
    workflow --> action : Allowed
    action -> db : Set Changes requested, unlock owner editing, append transition with note
    action -> notify : notifyOwners(changesRequested, note, comments) (L2-077)
    notify -> db : Insert in-app notification
    notify -> sqs : Enqueue EmailSendJob
    db --> action : Commit
    action --> route : Item
    route --> client : 200 JSON
    client --> dialog : Success
    dialog --> actor : Owner notified; item leaves the review queue
  end
end
@enduml
