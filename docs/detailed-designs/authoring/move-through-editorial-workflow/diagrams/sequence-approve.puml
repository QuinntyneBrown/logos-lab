@startuml
title UML sequence behaviour — Approve content
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Editor" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "ReviewItemPage" as page
  participant "ApproveDialog" as dialog
  participant "HttpStudioApi" as client
end box
box "Backend — Logos Lab API" #D1FADF
  participant "items/{id}/approve route" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "ApproveContentAction" as action
  participant "WorkflowService" as workflow
  participant "NotificationService" as notify
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
  queue "Job queue" as sqs
end box
actor -> page : Open the item for review
page -> page : canApprove is false when the editor authored the item
alt Editor authored the item
  page --> actor : Approve disabled; a different editor must approve (L2-076)
else Different editor
  actor -> page : Choose Approve
  page -> dialog : Open
  actor -> dialog : Add optional comment and confirm
  dialog -> client : approve(id, comment, rowVersion)
  client -> route : POST /api/v1/studio/items/{id}/approve
  route -> route : Authenticate and require Editor role
  route -> action : execute(editor, id, comment, rowVersion)
  action -> db : Load item and revision FOR UPDATE
  db --> action : Current state
  action -> workflow : canApprove(item, editor) and transition(revision, Approved, editor)
  alt Editor is the item's author
    workflow --> action : Refused
    action --> route : Forbidden
    route --> client : 403 problem response (L2-076)
    client --> dialog : Show failed state
  else Transition not in the L2-076 table, or stale rowVersion
    workflow --> action : Refused with current state
    action --> route : Conflict
    route --> client : 409 problem response with current state
    client --> dialog : Show failed state; comment kept
  else Allowed
    workflow --> action : Approved
    action -> db : Set Approved, append WorkflowTransition with comment
    action -> notify : notifyOwners(approved) (L2-077)
    notify -> db : Insert in-app notification
    notify -> sqs : Enqueue EmailSendJob
    db --> action : Commit
    action --> route : Item Approved
    route --> client : 200 JSON
    client --> dialog : Success
    dialog --> actor : Approved; ready to schedule or publish
  end
end
@enduml
