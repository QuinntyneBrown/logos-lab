@startuml
title UML sequence behaviour — List following
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "FollowingPage" as page
  participant "FollowsApi" as client
end box
box "Backend — Logos Lab API" #D1FADF
  participant "Follows route handler" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "ListFollowsAction" as action
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
end box
actor -> page : Open /dashboard/following
page -> client : list(Expert)
client -> route : GET /api/v1/me/follows?type=expert
route -> action : execute(userId, Expert)
action -> db : Follows where userId = caller, with expert details (L2-017)
db --> action : Rows and both counts
route --> client : 200 FollowList
page --> actor : Experts tab with Unfollow on each row (L2-074)
opt Collections tab
  actor -> page : Select Collections
  page -> client : list(Collection)
  client -> route : GET /api/v1/me/follows?type=collection
  route --> client : 200 FollowList
  page --> actor : Collections tab with Unfollow on each row
end
@enduml
