@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — View the dashboard overview

Container_Boundary(web, "Logos Lab Web") {
  Component(guard, "authGuard", "Angular route guard", "Redirects visitors to sign-in")
  Component(page, "DashboardPage", "Angular page", "Sections with own state")
  Component(client, "DashboardApi", "Contract + HttpDashboardApi", "Bound by DASHBOARD_API")
}
Container_Boundary(api, "Logos Lab API") {
  Component(route, "app/api/v1/me/dashboard", "Next.js route handlers", "One per section")
  Component(actions, "Section actions", "GetContinueLearningAction, GetUpcomingEventsAction, GetFollowingFeedAction, GetLearningSummaryAction", "Read-only use cases")
  Component(services, "Domain services", "LearningActivityService, EventRegistrationService, FollowFeedService", "Selection rules")
  Component(repos, "Repositories", "LearningActivityRepository, EventRegistrationRepository, FollowRepository, ContentRepository", "User-scoped reads")
}
ContainerDb(db, "Logos Lab database", "PostgreSQL", "Learner data")
Rel(guard, page, "Activates")
Rel(page, client, "Calls")
Rel(client, route, "Calls", "JSON/HTTPS")
Rel(route, actions, "Invokes")
Rel(actions, services, "Applies rules")
Rel(services, repos, "Reads")
Rel(repos, db, "Reads", "SQL")
@enduml
