@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — View my learning

Person(member, "Member", "Signed-in learner")
System_Boundary(ll, "Logos Lab") {
  Container(web, "Logos Lab Web", "Angular, Angular SSR on Node.js", "MyLearningPage")
  Container(api, "Logos Lab API", "Next.js route handlers, TypeScript", "ListMyLearningAction")
  ContainerDb(db, "Logos Lab database", "PostgreSQL on Amazon RDS", "enrolments, learning_activity")
}

Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "SQL")
@enduml
