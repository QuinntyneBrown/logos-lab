@startuml
title UML sequence behaviour — Cancel a registration
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Registrant" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "EventPage" as page
  participant "CancelRegistrationDialog" as dialog
  participant "EventsApi" as client
end box
box "Backend — Logos Lab API" #D1FADF
  participant "registration route handler" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "CancelRegistrationAction" as action
  participant "IcsCalendarService" as ics
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
  queue "Job queue (SQS)" as q
end box
actor -> page : Cancel registration
page -> dialog : Open
actor -> dialog : Confirm (L2-055)
dialog -> client : cancelRegistration(eventId)
client -> route : DELETE /api/v1/events/{eventId}/registration
route -> action : execute(userId, eventId)
action -> db : Lock event; set own registration Cancelled (L2-017)
action -> ics : cancel(event) for this member
action -> q : Enqueue email with .ics cancellation
action -> q : Enqueue WaitlistPromotionJob (L2-054)
route --> client : 204
alt Success
  dialog --> actor : "Registration cancelled"
else Failure
  dialog --> actor : "We couldn't cancel your registration", Try again
end
@enduml
