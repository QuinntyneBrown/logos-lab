@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Change user roles

Person(admin, "Administrator", "Logos Lab staff who manage users, roles and settings")
Person(member, "Member", "Signed-in Learner, Expert or staff member")
System(lab, "Logos Lab", "Expert-curated learning platform on Christianity and AI")
System_Ext(ses, "Amazon SES", "Sends account email")
System_Ext(cw, "Amazon CloudWatch", "Security event logs, metrics and alarms")
System_Ext(oncall, "On-call channel", "<TO SUPPLY>")

Rel(admin, lab, "Changes roles using", "HTTPS")
Rel(lab, member, "Notifies in app")
Rel(lab, ses, "Sends role email via")
Rel(lab, cw, "Logs role changes to")
Rel(cw, oncall, "Alerts on Administrator role changes")
@enduml
