@startuml
title UML sequence behaviour — Request an authenticated-only page
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member or crawler" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "SSR server" as ssr
  participant "NoIndexHeaderMiddleware" as noindex
  participant "Browser application" as spa
end box
box "Backend — Logos Lab API" #D1FADF
  participant "dashboard route" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "GetDashboardAction" as action
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
end box
actor -> ssr : GET /dashboard
ssr -> noindex : handle(request)
noindex -> noindex : Path matches member prefix
noindex --> ssr : Add X-Robots-Tag: noindex (Apply L2-142)
ssr -> ssr : serverRoutes gives RenderMode.Client
ssr --> actor : 200 application shell, no personal data
opt member's browser runs JavaScript
  actor -> spa : Load bundles
  spa -> route : GET /api/v1/dashboard with session cookie
  route -> action : execute(currentUser)
  action -> db : Load data scoped to user
  db --> action : Rows
  action --> route : Dashboard
  route --> spa : 200 JSON (not cached by CDN)
  spa --> actor : Render dashboard
end
@enduml
