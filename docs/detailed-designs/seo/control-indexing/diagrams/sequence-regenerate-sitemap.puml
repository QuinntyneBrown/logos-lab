@startuml
title UML sequence behaviour — Regenerate the sitemap
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Editor" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "Studio editor page" as page
end box
box "Backend — Logos Lab API" #D1FADF
  participant "publish route" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "PublishContentAction" as action
  participant "SitemapGenerateJob" as job
  participant "SitemapService" as svc
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  queue "Job queue" as queue
  participant "EventBridge Scheduler" as sched
  database "Logos Lab database" as db
  database "Media storage" as s3
end box
alt item published or archived
  actor -> page : Publish or archive
  page -> route : POST request
  route -> action : execute
  action -> db : Commit state change
  action -> queue : Enqueue SitemapGenerateJob (deduplicated)
else hourly schedule
  sched -> queue : Enqueue SitemapGenerateJob
end
queue -> job : Deliver
job -> svc : build()
loop each content type, in pages
  svc -> db : Select published items with lastmod
  db --> svc : Items
end
svc -> svc : Split into files of at most 50,000 URLs (Apply L2-145)
svc --> job : SitemapIndex
job -> s3 : Put sitemaps/{type}-{n}.xml
job -> s3 : Put sitemap.xml index last
note over job, s3 : Updated within 1 hour of the publish or archive (L2-145)
@enduml
