@startuml
title UML sequence behaviour — Generate a social image
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Editor" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "Studio editor page" as page
end box
box "Backend — Logos Lab API" #D1FADF
  participant "publish route" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "PublishContentAction" as action
  participant "SocialImageGenerateJob" as job
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  queue "Job queue" as queue
  database "Logos Lab database" as db
  database "Media storage" as s3
end box
actor -> page : Publish item
page -> route : POST publish request
route -> action : execute
action -> db : Mark item published
action -> queue : Enqueue SocialImageGenerateJob(itemId)
action --> route : Published
route --> page : 200
queue -> job : Deliver
job -> db : Load title, type and cover key
db --> job : Item
alt item has a cover image
  job -> s3 : Read cover
  job -> job : Crop and resize to 1200x630
else no cover image
  job -> job : Render branded image with title and type (Apply L2-143)
end
job -> s3 : Put social/{type}/{id}.png
job -> db : Save social_image_key
@enduml
