@startuml
title UML sequence behaviour — Redirect an old topic address
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor or member" as actor
participant "CDN (CloudFront)" as cdn
box "Frontend — Logos Lab Web" #E0F2FE
  participant "TopicPage (Angular SSR)" as page
  participant "TopicsApi" as client
end box
box "Backend — Logos Lab API" #D1FADF
  participant "GET /api/v1/topics/{slug}" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "GetTopicBySlugAction" as action
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
end box
actor -> cdn : GET /topics/old-slug
cdn -> page : Cache miss, render on server
page -> client : getBySlug(old-slug)
client -> route : HTTPS GET (anonymous)
route -> action : execute(old-slug)
action -> db : Find topic by slug
db --> action : None
action -> db : Find topic_redirects by old slug
alt redirect found
  db --> action : Current topic
  action --> route : redirectToSlug
  route --> client : 200 with redirect target
  page --> cdn : 301 Location /topics/new-slug (L2-096)
  cdn --> actor : 301, cached
else no topic and no redirect
  action --> route : Not found
  route --> client : 404
  page --> cdn : 404 not-found page (L2-005)
  cdn --> actor : 404
end
@enduml
