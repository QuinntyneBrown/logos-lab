@startuml
title UML sequence behaviour — Publish a policy version
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Administrator" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "PolicyEditorPage" as page
  participant "SiteAdminApi" as client
end box
box "Backend — Logos Lab API" #D1FADF
  participant "POST /api/v1/admin/policies/{type}/versions" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "CreatePolicyVersionAction" as action
  participant "PolicyService" as service
  participant "AuditLogService" as audit
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
end box
actor -> page : New version from Admin > Policies
page -> client : getPolicy(type)
client --> page : Current text as the starting point
actor -> page : Effective date, Material change, summary, text; schedule
page -> client : createPolicyVersion(type, input)
client -> route : HTTPS POST with CSRF token
route -> action : execute(actor, type, input)
alt summary missing, or material change with under 30 days notice (L2-119)
  action --> route : 422 problem
  page --> actor : Invalid state
else valid
  action -> service : nextVersion(type)
  action -> db : Insert policy_versions row; earlier versions untouched (L2-098)
  action -> audit : record("Policy version created", before, after)
  opt material change
    action -> db : Enqueue 30-day notice email (L2-119)
  end
  action -> db : Commit
  action --> route : 201 version
  page --> actor : Scheduled for the effective date
end
note over page, db : PolicyPage serves the version in effect, lists every version, and shows earlier and upcoming versions on request
@enduml
