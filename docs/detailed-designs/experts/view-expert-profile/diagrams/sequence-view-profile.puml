@startuml
title UML sequence behaviour — View an expert profile
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "ExpertProfilePage" as ExpertProfilePage
  participant "ExpertsApi" as ExpertsApi
end box
box "Backend — Logos Lab API" #D1FADF
  participant "GET /api/v1/experts/slug" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "GetExpertProfileAction" as GetExpertProfileAction
  participant "ExpertProfileService" as ExpertProfileService
  participant "BioSanitizer" as BioSanitizer
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
end box
actor -> ExpertProfilePage : Open /experts/abena-mensah
ExpertProfilePage -> ExpertsApi : getProfile(slug) during server render
ExpertsApi -> route : HTTPS GET (anonymous)
route -> GetExpertProfileAction : execute(slug)
GetExpertProfileAction -> ExpertProfileService : getPublicProfile(slug, now)
ExpertProfileService -> db : Select profile, Expert role, links and areas
db --> ExpertProfileService : Row or none
alt unknown slug, role removed or profile incomplete
  ExpertProfileService --> GetExpertProfileAction : ExpertNotFoundError
  GetExpertProfileAction --> route : Not found
  route --> ExpertsApi : 404 problem (L2-021)
  ExpertsApi --> ExpertProfilePage : Not found
  ExpertProfilePage --> actor : HTTP 404 and not-found page
else current expert
  ExpertProfileService -> BioSanitizer : Keep paragraphs, bold, italic, links (L2-021)
  BioSanitizer --> ExpertProfileService : Clean bio
  ExpertProfileService -> db : Count published items per type
  db --> ExpertProfileService : Counts
  ExpertProfileService -> ExpertProfileService : Keep tabs with at least 1 item
  ExpertProfileService --> GetExpertProfileAction : ExpertProfileView
  GetExpertProfileAction --> route : View
  route --> ExpertsApi : 200 JSON
  ExpertsApi --> ExpertProfilePage : View
  ExpertProfilePage --> actor : Photo with name as alt, details, up to 5 external links with rel=noopener noreferrer, tabs with counts
end
@enduml
