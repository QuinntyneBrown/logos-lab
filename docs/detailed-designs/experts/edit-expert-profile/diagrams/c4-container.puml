@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Edit an expert profile

Person(expert, "Expert", "Invited subject-matter expert")
Person(editor, "Editor", "Logos Lab staff who review and curate")
Person(visitor, "Visitor", "Anyone who is not signed in")
System_Boundary(logos, "Logos Lab") {
  Container(cdn, "CDN", "Amazon CloudFront with AWS WAF", "Serves the web application and public responses; never caches personal data")
  Container(web, "Logos Lab Web", "Angular, Angular SSR on Node.js", "Server-renders public pages and runs the single-page application")
  Container(api, "Logos Lab API", "Next.js route handlers, TypeScript", "JSON API under /api/v1 with actions and domain services")
  ContainerDb(db, "Logos Lab database", "PostgreSQL on Amazon RDS", "System of record and full-text search index")
}
Rel(expert, web, "Uses StudioProfilePage", "HTTPS")
Rel(editor, web, "Uses ExpertProfileHistoryPage", "HTTPS")
Rel(web, api, "Profile, history and restore endpoints", "JSON/HTTPS")
Rel(api, db, "Writes profile, versions, audit entries, notifications", "SQL")
Rel(visitor, cdn, "Requests /experts/slug", "HTTPS")
Rel(cdn, web, "Refreshes cached profile after at most 60 s", "HTTPS")
@enduml
