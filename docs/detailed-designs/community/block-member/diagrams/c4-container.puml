@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Block a member

Person(member, "Member", "Blocker")
System_Boundary(ll, "Logos Lab") {
  Container(web, "Logos Lab Web", "Angular, Angular SSR on Node.js", "BlockMemberDialog, BlockedMembersPage, CommentsSection")
  Container(api, "Logos Lab API", "Next.js route handlers, TypeScript", "Block actions and BlockService")
  ContainerDb(db, "Logos Lab database", "PostgreSQL on Amazon RDS", "member_blocks table")
}

Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "SQL")
@enduml
