@startuml
title UML sequence behaviour — Block a member
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "CommentsSection" as page
  participant "BlockMemberDialog" as dialog
  participant "BlocksApi" as client
end box
box "Backend — Logos Lab API" #D1FADF
  participant "Blocks route handler" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "BlockMemberAction" as action
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
end box
actor -> page : Choose "Block {name}" from comment actions
page -> dialog : Open with member summary
dialog --> actor : List effects of blocking
actor -> dialog : Press Block member
dialog -> client : block(memberId)
client -> route : PUT /api/v1/me/blocks/{memberId}
route -> route : CSRF, authenticate
route -> action : execute(userId, memberId)
alt memberId is the caller
  route --> client : 400 problem
  dialog --> actor : Show failed state
else other member
  action -> db : Insert member_blocks row if absent
  db --> action : Block
  action --> route : Block
  route --> client : 204
  dialog --> page : Close with success
  page -> page : Collapse that member's comments (L2-067)
  page --> actor : Toast "You blocked {name}"
end
@enduml
