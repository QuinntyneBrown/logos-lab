@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Accept the community guidelines

Person(member, "Member", "Contributor")
System_Boundary(ll, "Logos Lab") {
  Container(web, "Logos Lab Web", "Angular, Angular SSR on Node.js", "GuidelinesGate and CommunityGuidelinesDialog")
  Container(api, "Logos Lab API", "Next.js route handlers, TypeScript", "Policy actions and the contribution gate")
  ContainerDb(db, "Logos Lab database", "PostgreSQL on Amazon RDS", "policies, policy_versions, policy_acceptances")
}

Rel(member, web, "Uses", "HTTPS")
Rel(web, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "SQL")
@enduml
