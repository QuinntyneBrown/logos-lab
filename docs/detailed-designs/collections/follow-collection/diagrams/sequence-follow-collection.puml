@startuml
title UML sequence behaviour — Follow a collection
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Learner" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "CollectionPage" as CollectionPage
  participant "FollowsApi" as FollowsApi
  participant "FollowingPage" as FollowingPage
end box
box "Backend — Logos Lab API" #D1FADF
  participant "PUT /api/v1/me/follows/collections/collectionId" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "FollowCollectionAction" as FollowCollectionAction
  participant "FollowService" as FollowService
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
end box
actor -> CollectionPage : Press Follow
alt visitor (not signed in)
  CollectionPage --> actor : Ask to sign in first
else signed-in member
  CollectionPage -> FollowsApi : followCollection(collectionId)
  FollowsApi -> route : HTTPS PUT with session
  route -> route : Authenticate
  route -> FollowCollectionAction : execute(userId, collectionId)
  FollowCollectionAction -> FollowService : follow(userId, Collection collectionId)
  FollowService -> db : Insert follow if absent for current user (L2-017)
  db --> FollowService : Commit
  FollowService --> FollowCollectionAction : Follower count
  FollowCollectionAction --> route : FollowState
  route --> FollowsApi : 200 JSON
  FollowsApi --> CollectionPage : Following
  CollectionPage --> actor : Following with aria-pressed true; status explains notifications
  actor -> FollowingPage : Open /dashboard/following, Collections tab
  FollowingPage --> actor : Collection listed under Following (L2-050)
end
@enduml
