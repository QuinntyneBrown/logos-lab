@startuml
title UML sequence behaviour — Save collection items
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Expert" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "CollectionBuilderPage" as CollectionBuilderPage
  participant "StudioCollectionsApi" as StudioCollectionsApi
end box
box "Backend — Logos Lab API" #D1FADF
  participant "PUT /api/v1/studio/collections/collectionId/items" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "SaveCollectionItemsAction" as SaveCollectionItemsAction
  participant "CollectionCompositionService" as CollectionCompositionService
  participant "RevisionService" as RevisionService
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
end box
actor -> CollectionBuilderPage : Reorder, annotate and save
CollectionBuilderPage -> StudioCollectionsApi : saveItems(collectionId, items)
StudioCollectionsApi -> route : HTTPS PUT with session
route -> route : Authenticate; require Expert or Editor
route -> SaveCollectionItemsAction : execute(userId, collectionId, items)
SaveCollectionItemsAction -> db : Load collection within owner scope (L2-017)
alt not owned
  db --> SaveCollectionItemsAction : No row
  SaveCollectionItemsAction --> route : Not found
  route --> StudioCollectionsApi : 404 problem
else owned
  db --> SaveCollectionItemsAction : Collection
  SaveCollectionItemsAction -> CollectionCompositionService : validate(collection, items)
  CollectionCompositionService -> db : Read whether candidate collections contain collections or are nested
  CollectionCompositionService -> CollectionCompositionService : 1-100 published items; not itself; one level deep; notes up to 280 (L2-049)
  alt violations
    CollectionCompositionService --> SaveCollectionItemsAction : CompositionViolation[]
    SaveCollectionItemsAction --> route : Refused
    route --> StudioCollectionsApi : 422 problem with explanations
    StudioCollectionsApi --> CollectionBuilderPage : Violations
    CollectionBuilderPage --> actor : Error summary; rows flagged
  else valid
    alt collection is published
      SaveCollectionItemsAction -> RevisionService : openDraftRevision(collectionId, userId) (L2-080)
      RevisionService -> db : Insert or reuse draft revision; live version unchanged
      SaveCollectionItemsAction -> db : Replace items on the revision
    else draft collection
      SaveCollectionItemsAction -> db : Replace items on the draft
    end
    db --> SaveCollectionItemsAction : Commit
    SaveCollectionItemsAction --> route : Saved
    route --> StudioCollectionsApi : 200 JSON
    StudioCollectionsApi --> CollectionBuilderPage : Saved
    CollectionBuilderPage --> actor : Saved; changes to a published collection go through review
  end
end
@enduml
