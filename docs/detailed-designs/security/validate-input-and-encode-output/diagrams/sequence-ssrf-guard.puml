@startuml
title UML sequence behaviour — Refuse a link preview to a private address
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "Comment composer" as page
end box
box "Backend — Logos Lab API" #D1FADF
  participant "POST /api/v1/link-previews" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "LinkPreviewService" as svc
  participant "SafeUrlFetcher" as fetcher
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  participant "DNS resolver" as dns
  participant "External web site" as site
end box
actor -> page : Paste a link
page -> route : POST {url}
route -> route : Validate URL scheme is https or http (L2-105)
route -> svc : preview(url)
svc -> fetcher : fetch(url)
fetcher -> dns : Resolve host
dns --> fetcher : IP addresses
alt Any address is private, loopback, link-local or cloud metadata (L2-105 SSRF)
  fetcher --> svc : Refused
  svc --> route : No preview
  route --> page : 422 problem: link preview unavailable
else Public addresses only
  fetcher -> site : GET pinned to the checked address; redirects re-checked
  site --> fetcher : HTML
  fetcher --> svc : Title and description
  svc --> route : Preview
  route --> page : 200 preview JSON
end
@enduml
