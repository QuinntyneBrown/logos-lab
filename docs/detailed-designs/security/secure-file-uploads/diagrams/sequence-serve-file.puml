@startuml
title UML sequence behaviour — Serve a released file through the CDN
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "Page" as page
end box
box "Backend — Logos Lab API" #D1FADF
  participant "Route handler" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "MediaUrlService" as urls
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  participant "CDN (CloudFront)" as cdn
  participant "Media storage (S3)" as s3
end box
actor -> page : Open content with a file
page -> route : GET resource
route -> urls : Signed URL for released/<uuid>
urls --> route : CloudFront signed URL with expiry
route --> page : JSON with signed URL
page -> cdn : GET signed URL
cdn -> cdn : Verify signature and expiry
cdn -> s3 : Fetch through origin access control
s3 --> cdn : Object with platform-set metadata
cdn --> page : Body with platform Content-Type, Content-Disposition and nosniff (L2-108)
page --> actor : Image, video or download
@enduml
