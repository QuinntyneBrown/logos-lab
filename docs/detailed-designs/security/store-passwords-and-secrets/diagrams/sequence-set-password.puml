@startuml
title UML sequence behaviour — Hash and store a password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "RegisterPage or ResetPasswordPage" as page
  participant "AuthApi" as client
end box
box "Backend — Logos Lab API" #D1FADF
  participant "Route handler" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "SetPasswordAction" as action
  participant "PasswordHasher" as hasher
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  participant "LogRedactor" as redact
  database "Logos Lab database" as db
end box
actor -> page : Enter a new password
page -> client : setPassword(...)
client -> route : POST over HTTPS
route -> redact : Request log entry without the password field (L2-109)
route -> action : execute(userId, password)
action -> hasher : hash(password)
hasher -> hasher : Argon2id, memory >= 19 MiB, iterations >= 2, unique random salt (L2-109)
hasher --> action : Encoded hash with parameters and salt
action -> db : UPDATE credentials SET password_hash
action --> route : Done; plaintext discarded
route --> client : 204
client --> page : Saved
page --> actor : Confirmation
@enduml
