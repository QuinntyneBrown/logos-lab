@startuml
title UML sequence behaviour — Load application secrets at start-up
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Deployment pipeline" as actor
box "Backend — Logos Lab API" #D1FADF
  participant "Logos Lab API task" as app
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "SecretProvider" as provider
  participant "SigningKeyRing" as ring
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  participant "AWS Secrets Manager" as sm
  database "Logos Lab database" as db
end box
actor -> app : Start task from an image that holds no secrets (L2-109)
app -> provider : refresh()
provider -> sm : GetSecretValue(database, api keys, signing keys) with task role
sm --> provider : Secret values
provider --> app : Cached in memory only
app -> ring : Load current and previous signing keys
app -> db : Connect with the database credential
app --> actor : Healthy; secrets never written to logs
@enduml
