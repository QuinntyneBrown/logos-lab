@startuml
title UML sequence behaviour — Set security headers on an HTML response
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "SSR server" as ssr
  participant "SecurityHeadersHandler" as hdr
  participant "ContentSecurityPolicyBuilder" as csp
  participant "Angular renderer" as ng
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  participant "CDN (CloudFront)" as cdn
end box
actor -> cdn : GET https://www.logoslab.ca/
cdn -> ssr : Forward page request
ssr -> hdr : Handle request
hdr -> hdr : Create random per-response nonce
hdr -> csp : build(nonce, config)
csp --> hdr : script-src 'self' 'nonce-...' without unsafe-inline or unsafe-eval; frame-ancestors 'none'
hdr -> hdr : Set HSTS max-age=31536000; includeSubDomains; preload (L2-104)
hdr -> hdr : Set nosniff, strict-origin-when-cross-origin, Permissions-Policy (L2-104)
hdr -> ng : Render with CSP_NONCE = nonce
ng --> ssr : HTML whose inline scripts carry the nonce
ssr --> cdn : 200 HTML with ResponseHeaderSet
cdn --> actor : 200 HTML
@enduml
