@startuml
title UML sequence behaviour — Handle an unhandled exception
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "Page" as page
  participant "ServerErrorPage" as errpage
end box
box "Backend — Logos Lab API" #D1FADF
  participant "RequestLoggingMiddleware" as reqlog
  participant "ExceptionHandlingMiddleware" as exc
  participant "Route handler" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "Action" as action
  participant "Logger" as logger
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "CloudWatch Logs" as logs
end box
actor -> page : Perform action
page -> reqlog : API request
reqlog -> exc : next()
exc -> route : next()
route -> action : execute
action --> route : throws Error
route --> exc : Unhandled exception
exc -> logger : error(stack trace, correlationId)
logger -> logs : Full stack trace, server only (Apply L2-137)
exc --> reqlog : 500 problem: generic title and correlationId
reqlog -> logs : Request log entry with status 500
reqlog --> page : 500 with X-Correlation-Id
page -> errpage : Show server error state
errpage --> actor : "Something went wrong on our side" with reference
@enduml
