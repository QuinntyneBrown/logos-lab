@startuml
title UML sequence behaviour — Continuous backup and replication
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "Logos Lab Web" as web
end box
box "Backend — Logos Lab API" #D1FADF
  participant "Logos Lab API" as api
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "Action" as action
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
  database "RDS backup storage" as backup
  database "Media storage (Canada Central)" as s3
  database "Replica bucket (Canada West)" as replica
end box
actor -> web : Save progress or upload media
web -> api : API request
api -> action : execute
action -> db : Write rows in one transaction
action -> s3 : PutObject (new version kept)
action --> api : Result
api --> web : Response
loop every 5 minutes
  db -> backup : Ship transaction logs (Apply L2-138 RPO of 5 minutes or less)
end
loop daily
  db -> backup : Automated snapshot, kept 35 days
end
s3 -> replica : Replicate new object version (Apply L2-138 second Canadian region)
@enduml
