@startuml
title UML sequence behaviour — Survive the loss of one availability zone
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "Logos Lab Web (zone B)" as web
end box
box "Backend — Logos Lab API" #D1FADF
  participant "Application Load Balancer" as alb
  participant "Logos Lab API (zone B)" as api
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "Health endpoints" as health
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "RDS primary (zone A)" as dbA
  database "RDS standby (zone B)" as dbB
end box
note over dbA : Zone A fails
alb -> health : Probe /health/ready on zone A instances
health --> alb : No response
alb -> alb : Mark zone A targets unhealthy and stop routing
dbA -> dbB : Multi-AZ failover promotes standby
dbB --> api : Database endpoint resolves to new primary
actor -> web : Request page
web -> alb : API request
alb -> api : Route to healthy zone B instance
api -> dbB : Query
dbB --> api : Rows
api --> web : Response
web --> actor : Page rendered (Apply L2-135 outage of at most 5 minutes)
@enduml
