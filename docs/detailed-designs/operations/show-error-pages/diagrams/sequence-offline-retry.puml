@startuml
title UML sequence behaviour — Retry after the network returns
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Logos Lab Web" #E0F2FE
  participant "Lesson page" as page
  participant "OfflineInterceptor" as interceptor
  participant "ConnectivityService" as conn
  participant "ll-alert offline notice" as banner
end box
box "Backend — Logos Lab API" #D1FADF
  participant "Route handler" as route
end box
box "Backend — Logos Lab Application and Domain" #ECFDF3
  participant "Action" as action
end box
box "Backend — Logos Lab Infrastructure" #FFF4E5
  database "Logos Lab database" as db
end box
actor -> page : Mark lesson complete
page -> interceptor : POST request
interceptor -> interceptor : Network error (status 0)
interceptor -> conn : Report offline, record retryable action
conn -> banner : Show offline notice with retry (Apply L2-141)
banner --> actor : "You're offline" notice
conn -> conn : Detect online event
conn -> banner : Switch to success state with "Try again"
actor -> banner : Try again
banner -> conn : retryPending()
conn -> route : Resend request
route -> action : execute
action -> db : Save
db --> action : Committed
action --> route : Result
route --> conn : 200
conn --> page : Result
page --> actor : Lesson marked complete
@enduml
